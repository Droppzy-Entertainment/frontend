# Droppzy Entertainment — frontend environment variables
# Copy this file to .env.local and fill in real values for local development.
# See lib/env.ts for the Zod schema that validates these at boot.

# API key for the Resend transactional email service. Used by lib/mail.ts to
# dispatch Talent Form and Contact Form submissions. Get one at resend.com.
RESEND_API_KEY=

# The "From" address used when sending outbound mail via Resend. Must be a
# verified sender/domain in your Resend account.
MAIL_FROM_ADDRESS=

# Inbox that receives Contact form submissions.
CONTACT_RECIPIENT_EMAIL=

# Inbox that receives Talent form submissions. Optional — if unset, falls
# back to CONTACT_RECIPIENT_EMAIL (see lib/env.ts).
TALENT_RECIPIENT_EMAIL=

# Optional comma-separated list of additional allowed request origins for the
# API routes' Origin/Referer check (beyond NEXT_PUBLIC_SITE_URL itself).
# Example: https://staging.droppzy.example,https://preview.droppzy.example
ALLOWED_ORIGINS=

# Maximum number of requests allowed per IP per route within the rate-limit
# window. Defaults to 5 if unset.
RATE_LIMIT_MAX=5

# Length of the rate-limit fixed window, in milliseconds. Defaults to 600000
# (10 minutes) if unset.
RATE_LIMIT_WINDOW_MS=600000

# Public canonical site URL (no trailing slash). Used for metadata,
# sitemap/robots generation, and the API routes' same-origin check. Must be
# prefixed NEXT_PUBLIC_ to be readable in client components/browser code.
NEXT_PUBLIC_SITE_URL=

# Public URL of the Droppzy YouTube channel. Used by Subscribe buttons/links
# across the site. Must be prefixed NEXT_PUBLIC_ to be readable client-side.
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=
